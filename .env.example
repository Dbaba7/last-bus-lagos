# --- Game server (read by apps/server and `npm run dev`) ---

# Port the game server listens on in production / `npm run start:server`.
PORT=2567
# Comma-separated origins allowed to connect. Required when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development | production | test. `test` shortens match timers for the test suites.
# NODE_ENV=production
# Only when exactly one trusted proxy fronts a private server port:
# TRUST_PROXY=1
# Port `npm run dev` gives the game server (defaults to 2567).
# GAME_SERVER_PORT=2567

# --- Client build (Vite) ---

# Public URL only; never put secrets in VITE variables. Set before `npm run build`.
# VITE_SERVER_URL=https://your-persistent-game-server.example

# --- Test timers (only when NODE_ENV=test) ---

# TEST_COUNTDOWN_SECONDS=0.2
# TEST_MATCH_SECONDS=3
# TEST_RESULTS_SECONDS=1
# 1 = integration tests run the compiled dist/server instead of the TypeScript source.
# TEST_COMPILED=1
# Point integration tests at an already-running server instead of starting one.
# GAME_SERVER_URL=http://localhost:2570

# --- Browser and multiplayer scripts (scripts/, tests/multiplayer/) ---

# Page the Playwright scripts open (defaults to http://localhost:5173).
# GAME_URL=http://localhost:5173
# Use an existing Chromium instead of `npx playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# 1 = multiplayer smoke test plays the full four-minute match.
# SMOKE_FULL_MATCH=1
# Soak test length in seconds (default 1800).
# SOAK_SECONDS=1800
# CPU throttle factor for radio/voice checks; RUNS and DELAY (ms) tune voice-cold-check.
# THROTTLE=1
# RUNS=3
# DELAY=900
# visual-tour: comma-separated parts and output folder.
# TOUR=traversal,chapter1,ending,chapter2
# TOUR_OUT=artifacts/tour
# scene-preview / shot-frames: scenes, start time (ms), output name, flags, viewport, mission.
# SCENES=
# AT=1400
# OUT=latest
# FLAGS=
# VIEW=1600x900
# MISSION=the-passenger
# responsive-audit: comma-separated viewport names to check.
# ONLY=
